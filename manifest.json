{
  "manifest_version": 3,
  "name": "YT Loop",
  "version": "1.0.0",
  "description": "Loop a section of a YouTube video from the sidebar.",
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open YT Loop"
  }
}
